# VoterAI administrator configuration
# Never commit the real values to GitHub.
ADMIN_EMAIL=admin@institution.edu
# SHA-256 hex digest of the admin password. Generate locally with:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "YOUR_PASSWORD"
ADMIN_PASSWORD_SHA256=replace_with_sha256_hash
# Generate a long random value locally; never expose it in client code.
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
